##############################################
# Owlby-api (env example for Vercel)
##############################################

# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Web base URL for redirects
WEB_BASE_URL=https://owlby.com

# AI provider (Gemini required; OpenAI-compatible optional)
GEMINI_API_KEY=
# Optional: for OpenAI-compatible models (OpenAI, DeepSeek, Azure). Set OPENAI_BASE_URL for non-OpenAI (e.g. https://api.deepseek.com).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com

# Debug: log full AI prompt and response (no truncation). Set to true in Vercel to inspect logs.
# ENABLE_AI_DEBUG_LOGS=false

# API logger: timeout for flushing usage logs to Supabase (ms). Default 15000. Increase if you see API_LOGGER_FLUSH_TIMEOUT.
# API_LOGGER_FLUSH_TIMEOUT_MS=15000

# Subscriptions
REVENUECAT_WEBHOOK_SECRET=
FREE_TIER_DAILY_LIMIT=3